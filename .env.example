TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION_STRING=your_telethon_string_session

ALERT_BOT_TOKEN=123456789:your_bot_token
ALERT_CHAT_ID=123456789

# Railway Postgres URL. Strongly recommended so last_message_id survives restarts.
DATABASE_URL=postgresql://user:password@host:port/database

SOURCE_CHANNELS=CoinMarketCapAnnouncements,CoinDeskGlobal,coinlistofficialchannel,OKXAnnouncements,dwflabs,crypto_fundraising,Bloomberg,the_block_crypto,binance_announcements
ERROR_RETRY_SECONDS=20
POLL_SECONDS=5
BACKFILL_LIMIT=50
LOG_LEVEL=INFO
